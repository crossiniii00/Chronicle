# SERVER CONFIG
PORT=4000
APP_BASE_URL=https://recruitms.local
SESSION_SECRET=change_me_in_production
CORS_ORIGIN=https://recruitms.local

# POSTGRES CONFIG
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recruitms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# EMAIL / SMTP CONFIG
# For Gmail: host=smtp.gmail.com, port=465, secure=true
# For Outlook/Office365: host=smtp.office365.com, port=587, secure=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Recruitment360" <noreply@company.com>

# AI CONFIG
# Provider: "stub" (no key, deterministic fallback), "openai", "anthropic", or "gemini"
# When the key is missing, the service silently falls back to the stub.
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=minimax-m3-free
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
AI_TIMEOUT_MS=15000
